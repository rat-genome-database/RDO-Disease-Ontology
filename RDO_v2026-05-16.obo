creation_date: 2017-10-31T00:00:00Z

[Term]
id: DOID:0050198
name: Chapare hemorrhagic fever
def: "A viral infectious disease that is a hemorrhagic fever, has_material_basis_in Chapare virus (Mammarenavirus chapareense). The infection has symptom headache, has symptom joint pain, has symptom muscle pain, has symptom vomiting, has symptom shock, and has symptom bleeding. (DO)" [http://www.ncbi.nlm.nih.gov/sites/entrez/18421377 "DO"]
xref: MONDO:0017878
is_a: DOID:3944 ! Arenaviridae infectious disease
created_by: rgd
creation_date: 2017-10-31T00:00:00Z

[Term]
id: DOID:0050199
name: Whitewater Arroyo hemorrhagic fever
def: "A viral infectious disease that is a hemorrhagic fever, has_material_basis_in Whitewater Arroyo virus (Mammarenavirus whitewaterense), which is transmitted_by white-throated woodrats (Neotoma albigula). The infection has_symptom fever, has_symptom headache, has_symptom myalgia, and has_symptom hemorrhagic manifestations. (DO)" [http://jama.ama-assn.org/cgi/content/full/284/10/1237 "DO", http://www.ncbi.nlm.nih.gov/sites/entrez/1799746 "DO"]
xref: MONDO:000028
