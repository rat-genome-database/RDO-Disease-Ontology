xref: ICD9CM:516.1
xref: MESH:D000097545
xref: MIM:178550
xref: MIM:235500
xref: MONDO:0008346
xref: ORDO:99931
is_a: DOID:12119 ! hemosiderosis
is_a: DOID:850 ! lung disease

