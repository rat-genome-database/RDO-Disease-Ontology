synonym: "primary bacterial peritonitis" EXACT []
synonym: "primary peritonitis" EXACT []
synonym: "Retractile mesenteritis" EXACT []
synonym: "sclerosing mesenteritis" EXACT []
synonym: "secondary peritonitis" EXACT []
synonym: "spontaneous bacterial peritonitis" NARROW []
