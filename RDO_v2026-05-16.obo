synonym: "acute obstructive laryngitis" EXACT []
synonym: "croup syndrome" EXACT []
synonym: "Laryngotracheobronchitis" EXACT []
synonym: "Postintubation Croup" EXACT []
synonym: "Spasmodic Croup" EXACT []
synonym: "viral croup" EXACT []
