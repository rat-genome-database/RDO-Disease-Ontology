synonym: "CPP" EXACT []
synonym: "papilloma of choroid plexus" EXACT []
synonym: "papilloma of the choroid plexus" EXACT []
synonym: "pediatric papilloma of choroid plexus" EXACT [NCI2004_11_17:C5800]
