synonym: "Delta Hepatitis" EXACT []
synonym: "Delta Infection" EXACT []
synonym: "Delta Superinfection" EXACT []
synonym: "HDV" EXACT []
synonym: "hepatitis D virus infection" EXACT []
synonym: "Labrea Disease" EXACT []
